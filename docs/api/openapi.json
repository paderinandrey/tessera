{
  "components": {
    "schemas": {
      "DetectRequest": {
        "properties": {
          "layers": {
            "anyOf": [
              {
                "items": {
                  "enum": [
                    "deterministic",
                    "ner"
                  ],
                  "type": "string"
                },
                "type": "array"
              },
              {
                "type": "null"
              }
            ],
            "description": "Layers to run. May only narrow what the server runs; omit for all.",
            "title": "Layers"
          },
          "text": {
            "description": "Text to scan, in original coordinates",
            "minLength": 1,
            "title": "Text",
            "type": "string"
          }
        },
        "required": [
          "text"
        ],
        "title": "DetectRequest",
        "type": "object"
      },
      "DetectResponse": {
        "properties": {
          "layers_run": {
            "description": "Layers that actually ran for this request",
            "items": {
              "enum": [
                "deterministic",
                "ner"
              ],
              "type": "string"
            },
            "title": "Layers Run",
            "type": "array"
          },
          "spans": {
            "items": {
              "$ref": "#/components/schemas/Span"
            },
            "title": "Spans",
            "type": "array"
          }
        },
        "required": [
          "spans",
          "layers_run"
        ],
        "title": "DetectResponse",
        "type": "object"
      },
      "HTTPValidationError": {
        "properties": {
          "detail": {
            "items": {
              "$ref": "#/components/schemas/ValidationError"
            },
            "title": "Detail",
            "type": "array"
          }
        },
        "title": "HTTPValidationError",
        "type": "object"
      },
      "HealthResponse": {
        "properties": {
          "ner": {
            "title": "Ner",
            "type": "boolean"
          },
          "ner_off_reason": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Ner Off Reason"
          },
          "status": {
            "const": "ok",
            "title": "Status",
            "type": "string"
          }
        },
        "required": [
          "status",
          "ner",
          "ner_off_reason"
        ],
        "title": "HealthResponse",
        "type": "object"
      },
      "Span": {
        "properties": {
          "boosted": {
            "default": false,
            "title": "Boosted",
            "type": "boolean"
          },
          "confidence": {
            "maximum": 1.0,
            "minimum": 0.0,
            "title": "Confidence",
            "type": "number"
          },
          "end": {
            "description": "Character offset in the original text, exclusive",
            "minimum": 1.0,
            "title": "End",
            "type": "integer"
          },
          "entity_type": {
            "title": "Entity Type",
            "type": "string"
          },
          "recognizer": {
            "title": "Recognizer",
            "type": "string"
          },
          "start": {
            "description": "Character offset in the original text, inclusive",
            "minimum": 0.0,
            "title": "Start",
            "type": "integer"
          },
          "tier": {
            "maximum": 3.0,
            "minimum": 1.0,
            "title": "Tier",
            "type": "integer"
          }
        },
        "required": [
          "entity_type",
          "start",
          "end",
          "confidence",
          "recognizer",
          "tier"
        ],
        "title": "Span",
        "type": "object"
      },
      "ValidationError": {
        "properties": {
          "ctx": {
            "title": "Context",
            "type": "object"
          },
          "input": {
            "title": "Input"
          },
          "loc": {
            "items": {
              "anyOf": [
                {
                  "type": "string"
                },
                {
                  "type": "integer"
                }
              ]
            },
            "title": "Location",
            "type": "array"
          },
          "msg": {
            "title": "Message",
            "type": "string"
          },
          "type": {
            "title": "Error Type",
            "type": "string"
          }
        },
        "required": [
          "loc",
          "msg",
          "type"
        ],
        "title": "ValidationError",
        "type": "object"
      }
    }
  },
  "info": {
    "summary": "PII detection over text, in original coordinates",
    "title": "Tessera detector",
    "version": "0.1.0"
  },
  "openapi": "3.1.0",
  "paths": {
    "/detect": {
      "post": {
        "operationId": "detect_detect_post",
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/DetectRequest"
              }
            }
          },
          "required": true
        },
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/DetectResponse"
                }
              }
            },
            "description": "Successful Response"
          },
          "422": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            },
            "description": "Validation Error"
          }
        },
        "summary": "Detect"
      }
    },
    "/health": {
      "get": {
        "operationId": "health_health_get",
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HealthResponse"
                }
              }
            },
            "description": "Successful Response"
          }
        },
        "summary": "Health"
      }
    }
  }
}
